{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Services": {
    "InsightsDatabase": "http://localhost:50052"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Kafka": {
    "Enabled": false
  },
  "Insights": {
    "Namespace": "maichess",
    "Image": "ghcr.io/maichess/maichess-insights-spark:main",
    "SparkVersion": "3.5.3",
    "IngestionMainClass": "maichess.insights.ingest.IngestJob",
    "AnalysisMainClass": "maichess.insights.analysis.AnalysisJob",
    "JarPath": "local:///opt/spark/jars/maichess-insights-spark.jar",
    "ServiceAccount": "spark",
    "MongoUri": "",
    "MongoDb": "maichess",
    "RawBucket": "insights-raw",
    "ParsedBucket": "insights-parsed",
    "AggBucket": "insights-agg",
    "ReplayBoard": true,
    "BookPlies": 10,
    "MinReach": 50,
    "MinSupport": 30,
    "DefaultRatingBand": "",
    "DefaultTimeControl": "",
    "DefaultSampleRate": 0.1,
    "PriorityClassName": "insights-low-priority",
    "ComputeNodeHostname": "",
    "DriverCores": 1,
    "DriverMemory": "2g",
    "ExecutorInstances": 2,
    "ExecutorCores": 4,
    "ExecutorMemory": "6g",
    "Minio": {
      "Endpoint": "minio:9000",
      "AccessKey": "",
      "SecretKey": "",
      "UseSsl": false
    }
  }
}
